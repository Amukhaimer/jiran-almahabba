# Copy to .env on the server (chmod 600). Never commit the real file.

# Required. Signs login sessions; changing it signs everyone out.  openssl rand -hex 32
SESSION_SECRET=

# One-time token for creating the admin account at /setup. Unused once an account exists.
SETUP_TOKEN=

# Optional. Only if port 3100 is taken; must match the nginx proxy_pass line.
# APP_PORT=3100
